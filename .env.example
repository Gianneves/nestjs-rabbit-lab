# Copie para .env e ajuste:  cp .env.example .env
# Estes valores precisam bater com RABBITMQ_DEFAULT_USER/PASSWORD do docker-compose.yml.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# URL completa (quando definida, os serviços a usam em vez de montar a partir dos campos acima).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Portas HTTP dos serviços com API REST.
PORT_API_GATEWAY=3000
PORT_ORDER_RABBITMQ=3001
PORT_PAYMENT=3002
