{
  "name": "order-rabbitmq",
  "version": "0.0.1",
  "description": "Laboratório hands-on de microsserviços com NestJS + RabbitMQ: api-gateway, order, payment e notification — fluxo de pedido orientado a eventos.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:order-service": "nest start order-service --watch",
    "start:dev:payment-service": "nest start payment-service --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "start:dev:order-rabbitmq": "nest start order-rabbitmq --watch",
    "start:dev:all": "concurrently -n \"gateway,order,payment,notify\" -c \"green,cyan,magenta,yellow\" \"npm run start:dev:api-gateway\" \"npm run start:dev:order-service\" \"npm run start:dev:payment-service\" \"npm run start:dev:notification-service\" --kill-others-on-fail",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/order-rabbitmq/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "viapps/order-rabbitmq/test run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
